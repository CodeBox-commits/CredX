# CredX API configuration. Copy to backend/.env (or export as environment variables).
# Every value has a working local default; nothing here is required to run the demo.

# --- application ---
ENVIRONMENT=development            # development | test | staging | production (production enforces a strong JWT_SECRET)
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production for log aggregation
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTRY_DSN=

# --- persistence ---
DATABASE_URL=sqlite:///./storage/credx.db   # postgresql://user:pass@host:5432/credx in production
AUTO_CREATE_TABLES=true            # false when migrations run via `alembic upgrade head`

# --- background jobs ---
JOB_BACKEND=thread                 # celery (production) | thread (single container) | inline (tests)
JOB_WORKERS=2
REDIS_URL=                         # redis://localhost:6379/0 — Celery broker + research cache

# --- security ---
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ACCESS_TOKEN_MINUTES=720
ALLOW_SELF_SIGNUP=true             # the first registered account becomes admin

# --- storage & uploads ---
STORAGE_BACKEND=local              # local | s3
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=                   # set for Cloudflare R2 / Supabase Storage / MinIO
MAX_UPLOAD_MB=25

# --- document AI ---
OCR_ENGINE=tesseract               # tesseract | none
ENABLE_CAMELOT=true

# --- secondary research (live providers are used only when keys are present) ---
RESEARCH_LIVE=false                # true enables keyless Google News RSS
NEWSAPI_KEY=
SERPAPI_KEY=

# --- AI copilot / CAM narrative (falls back to the grounded local provider) ---
AI_PROVIDER_ORDER=anthropic,openai,gemini,local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- credit policy ---
RBI_REPO_RATE=5.50
BASE_LENDING_RATE=9.25
MODEL_DIR=./scoring/models/artifacts
